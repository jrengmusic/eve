#!/usr/bin/env bash
# EVE terminal command - do not edit

_eve_encode() {
    local LC_ALL=C
    local text="$1" char encoded='' i
    for (( i = 0; i < ${#text}; ++i )); do
        char="${text:$i:1}"
        case "$char" in
            '%'|';'|'#'|'?'|[[:cntrl:]]) encoded+="$(printf '%%%02X' "'$char")" ;;
            *) encoded+="$char" ;;
        esac
    done
    printf '%s' "$encoded"
}

if command -v cygpath > /dev/null 2>&1; then
    _eve_path() { cygpath -m "$(realpath "$1")"; }
    _eve_cwd() {
        local directory
        directory="$(cygpath -m "$PWD")"
        case "$directory" in
            //*) printf '%s' "${directory#//}" ;;
            *) printf '/%s' "$directory" ;;
        esac
    }
else
    _eve_path() { realpath "$1"; }
    _eve_cwd() { printf '%s' "$PWD"; }
fi

eve() {
    case "$1" in
        command) printf '\033]1337;EVE;command;name=%s\007' "$(_eve_encode "$2")" ;;
        preview) printf '\033]1337;EVE;preview;inline=1;width=%s;height=%s%s;path=%s\007' "${FZF_PREVIEW_COLUMNS:-100%}" "${FZF_PREVIEW_LINES:-100%}" "${3:+;$3}" "$(_eve_encode "${2:+$(_eve_path "$2")}")" ;;
        *) printf "eve: unknown command '%s'; use command or preview\n" "$1" >&2; return 1 ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    eve "$@"
fi
